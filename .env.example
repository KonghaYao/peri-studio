# 复制为 .env 后按需填写；./dev.sh 会自动加载，shell 已导出的变量优先。
# .env 已 gitignore，勿提交真实密钥。

# Langfuse（可选；`peri-studio` 启动时会加载本文件与 `~/.config/peri-studio/.env`，不覆盖已 export 的变量）
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=  # 可选；LANGFUSE_BASE_URL 优先
# 亦可写入 ~/.config/peri-studio/config.toml：langfuse_public_key / langfuse_secret_key / langfuse_base_url

# 实时语音上游（可选，见 docs/design/realtime-voice.md）
# PERI_REALTIME_VOICE_BASE_URL=http://127.0.0.1:8000
# PERI_REALTIME_VOICE_API_KEY=

# 开发目录与端口（可选，默认见 docs/local-dev-experience.md）
# PERI_STUDIO_CONFIG_DIR=
# PERI_STUDIO_DATA_DIR=
# PERI_STUDIO_LISTEN_ADDR=127.0.0.1
# PERI_STUDIO_LISTEN_PORT=8456
