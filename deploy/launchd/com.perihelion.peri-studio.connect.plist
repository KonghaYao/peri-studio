<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.perihelion.peri-studio.connect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/peri-studio</string>
    <string>connect</string>
    <string>ws://127.0.0.1:8456/instance</string>
    <string>--token-file</string>
    <string>/Users/REPLACE_ME/.config/peri-studio/instance.token</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/Peri Studio/instance.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/Peri Studio/instance.log</string>
</dict>
</plist>
