{
  "name": "peri-studio-web",
  "private": true,
  "version": "0.2.3",
  "license": "Apache-2.0",
  "type": "module",
  "description": "peri-studio SolidJS Web client and tested UI component library",
  "scripts": {
    "dev": "vite",
    "visual:dev": "vite --host 127.0.0.1",
    "verify:production-boundary": "node scripts/verify-production-boundary.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --test tests/*.test.mjs && vitest run && node scripts/verify-production-boundary.mjs",
    "test:browser": "playwright test",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@iconify-icon/solid": "3.0.3",
    "@iconify-icons/vscode-icons": "2.0.2",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@peri/markdown": "workspace:*",
    "@peri/ui": "workspace:*",
    "katex": "^0.18.4",
    "lucide-solid": "^1.34.0",
    "markdown-to-jsx": "^9.9.0",
    "mermaid": "^11.17.0",
    "shiki": "^4.4.3",
    "solid-js": "^1",
    "yjs": "^13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
